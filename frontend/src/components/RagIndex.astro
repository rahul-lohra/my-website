---
import {getCollection} from 'astro:content';import {href} from '../lib/content';
const {kind}=Astro.props as {kind:'notes'|'projects'};const entries=await getCollection(kind==='notes'?'notes':'ragProjects',({data})=>!data.draft);
---
<section class="page-intro"><a class="back-link" href={href('/rag/')}>← RAG notebook</a><p class="eyebrow">{kind==='notes'?'THE FOUNDATIONS':'LEARNING BY BUILDING'}</p><h1>{kind==='notes'?'Fundamentals & notes.':'Projects & experiments.'}</h1><p>{kind==='notes'?'The concepts and questions behind retrieval-augmented generation.':'RAG implementations and the lessons from building them.'}</p></section>{entries.length?entries.map(p=><a class="result-item" href={href(`/rag/${kind}/${p.id}/`)}><div><h2>{p.data.title}</h2><p>{p.data.description}</p></div><span>↗</span></a>):<section class="placeholder"><span class="coming-label">COMING SOON</span><h2>{kind==='notes'?'The first page is still ahead.':'An open space for experiments.'}</h2><p>{kind==='notes'?'No notes have been published yet. Fundamentals and learning notes will appear here as they are added.':'No RAG projects have been published yet. Projects and their supporting details will appear here when available.'}</p><a class="text-link" href={href('/blog/')}>Explore my published writing →</a></section>}
