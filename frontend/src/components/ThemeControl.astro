<label class="theme-control">
  <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
  <span class="sr-only">Color theme</span>
  <select id="color-theme" aria-label="Color theme">
    <option value="system">System</option>
    <option value="light">Light</option>
    <option value="dark">Dark</option>
  </select>
</label>
<script>
  const select=document.querySelector<HTMLSelectElement>('#color-theme');
  if(select){
    const media=window.matchMedia('(prefers-color-scheme: dark)');
    const valid=(value:string|null|undefined)=>value==='light'||value==='dark'?value:'system';
    let preference=valid(document.documentElement.dataset.themePreference);
    const apply=()=>{
      const theme=preference==='system'?(media.matches?'dark':'light'):preference;
      document.documentElement.dataset.theme=theme;
      document.documentElement.dataset.themePreference=preference;
      document.documentElement.style.colorScheme=theme;
      select.value=preference;
    };
    apply();
    select.addEventListener('change',()=>{
      preference=valid(select.value);
      apply();
      try{localStorage.setItem('portfolio-theme',preference);}catch{/* The selection still works when storage is unavailable. */}
    });
    media.addEventListener('change',()=>{if(preference==='system')apply();});
    window.addEventListener('storage',event=>{
      if(event.key==='portfolio-theme'||event.key===null){preference=valid(event.newValue);apply();}
    });
  }
</script>
