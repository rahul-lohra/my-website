---
import Base from '../layouts/Base.astro';import {href} from '../lib/content';
import {profile} from '../lib/profile';import Experience from '../components/Experience.astro';
---
<Base title="About — Rahul Kumar Lohra | Android Platform Engineer" description={profile.summary}><section class="page-intro"><p class="eyebrow">{profile.headline}</p><h1>Reliable platforms.<br/><em>Stronger engineering teams.</em></h1></section><div class="about-layout"><div class="about-copy"><p>I’m {profile.name}, an Android platform engineer with over a decade of experience building mobile foundations, SDKs, and developer tools.</p><p>At GetStream.io, I work on the Android Video SDK and WebRTC: making calls more resilient to changing networks, improving audio routing, and evolving the architecture behind real-time communication.</p><p>Previously, I led Android architecture and infrastructure work at TikTok and held principal engineering roles at Tokopedia and Green Agrevolution. My work spans reusable platform components, performance profiling, developer tooling, and engineering standards that teams can adopt with confidence.</p><p>I enjoy turning ambiguous platform problems into clear architecture, practical diagnostics, and safer migrations. That same curiosity drives my open-source work, technical writing, and interest in retrieval-augmented generation.</p><div class="hero-actions"><a class="button" href={href('/resume/')}>View my résumé ↗</a><a class="text-link" href={href('/work/')}>Explore my projects →</a></div></div><aside class="about-aside"><p class="eyebrow">CORE EXPERTISE</p><h2>Tools of the trade</h2><div class="tags">{profile.skills.map(skill=><span>{skill}</span>)}</div><p class="eyebrow">FIND ME ELSEWHERE</p><a href="https://github.com/rahul-lohra">GitHub ↗</a><a href="https://www.linkedin.com/in/rahullohra/">LinkedIn ↗</a><a href="mailto:tgunix@gmail.com">tgunix@gmail.com ↗</a><a href={href('/resume/')}>Résumé ↗</a></aside></div><section class="section experience-section" id="experience"><div class="section-heading"><div><p class="eyebrow">THE PATH SO FAR</p><h2>Experience<span class="dot">.</span></h2></div><a class="text-link" href={href(profile.resumePath)} download>Download résumé ↓</a></div><Experience/></section></Base>
