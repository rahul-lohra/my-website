---
import Base from '../../layouts/Base.astro';import {render} from 'astro:content';import {posts,href,date,readingTime} from '../../lib/content';
export async function getStaticPaths(){const all=await posts();return all.map((post,i)=>({params:{slug:post.id},props:{post,previous:all[i+1],next:all[i-1]}}));}const {post,previous,next}=Astro.props;const {Content,headings}=await render(post);
---
<Base title={`${post.data.title} — Rahul Kumar Lohra`} description={post.data.description} type="article"><section class="article-header"><a class="back-link" href={href('/blog/')}>← All writing</a><p class="eyebrow">{post.data.topic} / FIELD NOTES</p><h1>{post.data.title}</h1><p class="article-deck">{post.data.description}</p><div class="author-line"><span class="author-avatar">RL</span><div><strong>Rahul Kumar Lohra</strong><span>{date(post.data.date)} · {readingTime(post.body||'')} min read</span></div></div></section><div class="article-layout"><article class="prose"><Content/></article><aside class="toc"><p class="eyebrow">ON THIS PAGE</p>{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}{!headings.length&&<p>A short field note.</p>}<a class="original-source" href={post.data.source}>Original source ↗</a></aside></div><nav class="article-pagination" aria-label="Other articles">{previous?<a href={href(`/blog/${previous.id}/`)}><span class="eyebrow">← OLDER NOTE</span><h3>{previous.data.title}</h3></a>:<span/>}{next&&<a href={href(`/blog/${next.id}/`)}><span class="eyebrow">NEWER NOTE →</span><h3>{next.data.title}</h3></a>}</nav></Base>
