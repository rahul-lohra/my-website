---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import {profile} from '../lib/profile';
import ProjectCard from '../components/ProjectCard.astro';
import PostRow from '../components/PostRow.astro';
import {projects,posts,href} from '../lib/content';
const recent=(await posts()).slice(0,3);
---
<Base><section class="hero"><div class="hero-copy"><p class="eyebrow hero-kicker"><span class="status-dot"></span> {profile.headline}</p><h1>Android platforms.<br/><em>Built for reliability.</em></h1><p class="hero-intro">I’m Rahul Kumar Lohra. I bring 10+ years of experience<br class="desktop-break"/> building mobile foundations, SDKs, and developer tools.</p><p class="hero-secondary">Platform architecture. Real-time communication. Performance.<br/>Currently building the Android Video SDK at GetStream.io.</p><div class="hero-actions"><a class="button" href={href('/work/')}>Explore my work <span>↗</span></a><a class="text-link" href={href('/blog/')}>Read the blog <span>→</span></a></div><div class="hero-topics"><span>Android & Kotlin</span><i>✳</i><span>Developer tools</span><i>✳</i><span>Exploring RAG</span></div></div><div class="hero-art" aria-label="An abstract illustration of connected ideas"><div class="art-grid"></div><span class="art-note top-note">A WORK IN PROGRESS.<br/>JUST LIKE THE BEST IDEAS.</span><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="hero-core">{'{'}<span>✳</span>{'}'}</div><span class="floating-label label-android">⌘ &nbsp; build thoughtfully</span><span class="floating-label label-code">&lt;/&gt; &nbsp; stay curious</span><span class="art-cross cross-one">+</span><span class="art-cross cross-two">+</span><div class="art-bottom"><span>IDEAS → CODE → SOMETHING USEFUL</span><span>01 / ∞</span></div></div></section>
<section class="section work-section"><div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2>Things I’ve been building<span class="dot">.</span></h2></div><a class="text-link" href={href('/work/')}>All projects <span>↗</span></a></div><div class="project-grid">{projects.filter(p=>p.featured).map(project=><ProjectCard project={project}/>)}</div></section>
<section class="section writing-section"><div class="section-heading"><div><p class="eyebrow">02 / THE BLOG</p><h2>Notes from the workbench<span class="dot">.</span></h2><p>Ideas, experiments, and the details worth writing down.</p></div><a class="text-link" href={href('/blog/')}>All writing <span>↗</span></a></div><div class="post-list">{recent.map(post=><PostRow post={post}/>)}</div></section>
<section class="section experience-section home-experience"><div class="section-heading"><div><p class="eyebrow">03 / EXPERIENCE</p><h2>Platforms, people, and progress<span class="dot">.</span></h2></div><a class="text-link" href={href('/about/#experience')}>Full experience <span>↗</span></a></div><Experience compact/></section>
<section class="rag-callout"><div class="rag-symbol" aria-hidden="true">✳</div><div><p class="eyebrow">04 / A NEW CHAPTER</p><h2>Making room for RAG.</h2><p>A space for retrieval-augmented generation: fundamentals,<br class="desktop-break"/> learning notes, and projects. The first entries are coming soon.</p></div><a class="text-link" href={href('/rag/')}>Explore the notebook <span>↗</span></a></section>
<section class="contact-strip"><p>Have an interesting problem in mind?</p><a href="mailto:tgunix@gmail.com">Let’s talk <span>↗</span></a></section></Base>
