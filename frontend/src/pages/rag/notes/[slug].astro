---
import {getCollection,render} from 'astro:content';import Base from '../../../layouts/Base.astro';import {href,date} from '../../../lib/content';
export async function getStaticPaths(){return(await getCollection('notes',({data})=>!data.draft)).map(post=>({params:{slug:post.id},props:{post}}));}const {post}=Astro.props;const {Content}=await render(post);
---
<Base title={`${post.data.title} — RAG notebook`} description={post.data.description}><section class="article-header"><a class="back-link" href={href('/rag/notes/')}>← RAG notes</a><h1>{post.data.title}</h1><p>Rahul Kumar Lohra · {date(post.data.date)}</p></section><article class="prose"><Content/></article></Base>
