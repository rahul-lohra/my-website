---
import Base from '../layouts/Base.astro';
import Experience from '../components/Experience.astro';
import {profile} from '../lib/profile';
import {href} from '../lib/content';
const pdf=href(profile.resumePath);
---
<Base title="Résumé — Rahul Kumar Lohra | Android Platform Engineer" description={profile.summary}><section class="page-intro resume-intro"><p class="eyebrow">EXPERIENCE & BACKGROUND</p><h1>Engineering reliable<br/><em>Android foundations.</em></h1><p class="professional-title">{profile.name} · {profile.headline}</p><p>{profile.summary}</p><div class="hero-actions"><a class="button" href={pdf} download="Rahul-Kumar-Lohra-Resume.pdf">Download résumé <span aria-hidden="true">↓</span></a><a class="text-link" href={pdf} target="_blank" rel="noopener">Open PDF <span aria-hidden="true">↗</span></a></div></section><details class="resume-preview"><summary>Preview the résumé PDF <span aria-hidden="true">+</span></summary><object data={pdf} type="application/pdf" aria-label="Rahul Kumar Lohra’s résumé"><p>Your browser may not support an embedded PDF. <a href={pdf}>Open the résumé PDF</a> or <a href={pdf} download>download a copy</a>.</p></object><p class="pdf-fallback">Prefer a separate view? <a href={pdf} target="_blank" rel="noopener">Open the PDF in a new tab ↗</a></p></details><section class="section experience-section" id="experience"><div class="section-heading"><div><p class="eyebrow">CAREER HISTORY</p><h2>Experience<span class="dot">.</span></h2></div></div><Experience/></section><section class="resume-foundations"><div><p class="eyebrow">CORE EXPERTISE</p><h2>Building blocks.</h2><div class="tags">{profile.skills.map(skill=><span>{skill}</span>)}</div></div><div><p class="eyebrow">EDUCATION & CREDENTIALS</p>{profile.education.map(item=><div class="education-entry"><h3>{item.title}</h3><p>{item.institution} · {item.period}</p></div>)}</div></section></Base>
