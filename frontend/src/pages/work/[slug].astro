---
import Base from '../../layouts/Base.astro';import ProjectVisual from '../../components/ProjectVisual.astro';import PostRow from '../../components/PostRow.astro';import {projects,posts,href} from '../../lib/content';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}const {project:p}=Astro.props;const related=(await posts()).filter(post=>p.articles.includes(post.id));
---
<Base title={`${p.title} — Rahul Kumar Lohra`} description={p.description}><section class="page-intro project-intro"><a class="back-link" href={href('/work/')}>← All projects</a><p class="eyebrow">{p.topic} / {p.kind}</p><h1>{p.title}<span class="dot">.</span></h1><p>{p.description}</p><div class="hero-actions"><a class="button" href={p.source}>View source on GitHub ↗</a><div class="tags">{p.tags.map(t=><span>{t}</span>)}</div></div></section><ProjectVisual slug={p.slug}/><div class="project-story"><section><p class="eyebrow">THE PROBLEM</p><h2>What it’s for</h2><p>{p.problem}</p></section><section><p class="eyebrow">THE APPROACH</p><h2>How it works</h2><p>{p.approach}</p><p>Explore the repository for implementation details and setup instructions.</p></section></div>{p.image&&<figure class="project-screenshot"><img src={href(p.image)} alt={p.imageAlt} loading="lazy"/><figcaption>Screenshot from the project’s source repository. The illustration above is a visual summary.</figcaption></figure>}{related.length>0&&<section class="section"><h2>Behind the build<span class="dot">.</span></h2>{related.map(post=><PostRow post={post}/>)}</section>}</Base>
